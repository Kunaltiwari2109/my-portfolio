# Local development backend URL for the contact form.
VITE_API_URL=http://localhost:5000

# If you deploy the backend separately, set it to the public backend URL.
# VITE_API_URL=https://<your-backend-host>.onrender.com

# Backend email credentials for sending contact confirmation.
# EMAIL_USER=your_email@gmail.com
# EMAIL_APP_PASSWORD=your_app_password
